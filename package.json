{
  "name": "server-dashboard",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite dev --host 127.0.0.1",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1",
    "prepare": "svelte-kit sync",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "start": "node build",
    "lint": "biome check . && prettier --check \"src/**/*.svelte\"",
    "format": "biome check --write . && prettier --write \"src/**/*.svelte\"",
    "test": "node --test tests/*.test.mjs",
    "validate": "bash scripts/check.sh && bun run lint && bun run check && bun run build && bun run test"
  },
  "devDependencies": {
    "@biomejs/biome": "2.3.14",
    "@sveltejs/adapter-node": "5.5.4",
    "@sveltejs/kit": "2.63.0",
    "@sveltejs/vite-plugin-svelte": "7.1.2",
    "@types/node": "24",
    "prettier": "3.9.6",
    "prettier-plugin-svelte": "4.1.1",
    "svelte": "5.56.1",
    "svelte-check": "4.6.0",
    "typescript": "6.0.3",
    "vite": "8.0.16"
  },
  "license": "UNLICENSED",
  "packageManager": "bun@1.3.14",
  "engines": {
    "node": ">=24 <27"
  }
}
