{
  "$schema": "https://biomejs.dev/schemas/2.3.14/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": [
      "src/**/*.ts",
      "src/**/*.css",
      "tests/**/*.mjs",
      "vite.config.ts",
      "package.json",
      "biome.json",
      "prettier.config.js",
      "design/portfolio/gallery.js",
      "design/portfolio/app.css"
    ]
  },
  "formatter": {
    "indentStyle": "space"
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true
    }
  },
  "assist": {
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  },
  "overrides": [
    {
      "includes": ["design/portfolio/gallery.js", "design/portfolio/app.css"],
      "formatter": {
        "indentStyle": "tab"
      }
    }
  ]
}
